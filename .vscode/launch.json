{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Catalog service: uvicorn reload",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend/services/catalog-service",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/services/catalog-service/src"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true
    }
  ]
}
