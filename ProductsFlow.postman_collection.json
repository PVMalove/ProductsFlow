    "event": [
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "try {",
                    "    var jsonData = pm.response.json();",
                    "    ",
                    "    // 1. Глобальный перехват токена",
                    "    if (jsonData.access_token) {",
                    "        pm.collectionVariables.set(\"token\", jsonData.access_token);",
                    "    }",
                    "",
                    "    // 2. Глобальный перехват ID для всех сущностей",
                    "    if (jsonData.data && jsonData.data.id) {",
                    "        var url = pm.request.url.getPath();",
                    "        if (url.includes(\"/products\")) {",
                    "            pm.collectionVariables.set(\"product_id\", jsonData.data.id);",
                    "        } else if (url.includes(\"/tickets\") && !url.includes(\"/messages\")) {",
                    "            pm.collectionVariables.set(\"ticket_id\", jsonData.data.id);",
                    "        } else if (url.includes(\"/messages\")) {",
                    "            pm.collectionVariables.set(\"message_id\", jsonData.data.id);",
                    "        } else if (url.includes(\"/users\") || url.includes(\"/register\")) {",
                    "            pm.collectionVariables.set(\"user_id\", jsonData.data.id);",
                    "        }",
                    "    }",
                    "} catch (e) {",
                    "    // Ответ не JSON (например 204 No Content), игнорируем",
                    "}"
                ]
            }
        },
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Умная подстановка токена, если стандартный Auth не сработал",
                    "var token = pm.collectionVariables.get(\"token\");",
                    "if (token && !pm.request.headers.has(\"Authorization\")) {",
                    "    var url = pm.request.url.getPath();",
                    "    // Не шлем токен на логин и регистрацию",
                    "    if (!url.includes(\"/auth/\")) {",
                    "        pm.request.headers.add({",
                    "            key: \"Authorization\",",
                    "            value: \"Bearer \" + token",
                    "        });",
                    "    }",
                    "}"
                ]
            }
        }
    ]
}